@@ -0,0 +1,69 @@
+/*
+ * 3dObjLib: Tests for geometric primitive operations
+ * Copyright (C) 2026 Christopher Bazley
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <assert.h>
+
+#include "Primitive.h"
+#include "Vertex.h"
+
+static int add_vertex(VertexArray * const varray,
+                      const Coord x, const Coord y)
+{
+  Coord coords[3] = {x, y, 0};
+  const int vertex = vertex_array_add_vertex(varray, &coords);
+  assert(vertex >= 0);
+  return vertex;
+}
+
+static void add_side(Primitive * const primitive, const int vertex)
+{
+  assert(primitive_add_side(primitive, vertex) >= 0);
+}
+
+int main(void)
+{
+  VertexArray varray;
+  vertex_array_init(&varray);
+
+  Primitive runway;
+  primitive_init(&runway);
+  add_side(&runway, add_vertex(&varray, -19985, 698));
+  add_side(&runway, add_vertex(&varray, 19993, -500));
+  add_side(&runway, add_vertex(&varray, 19988, -699));
+  add_side(&runway, add_vertex(&varray, -19996, 499));
+
+  Plane plane;
+  assert(primitive_find_plane(&runway, &varray, &plane));
+
+  Primitive centre_line;
+  primitive_init(&centre_line);
+  add_side(&centre_line, add_vertex(&varray, 19991, -599));
+  add_side(&centre_line, add_vertex(&varray, -19990, 599));
+
+  /* The first endpoint is just outside the runway, so full containment is
+     false even though almost the whole line overlaps the runway. */
+  assert(!primitive_contains(&runway, &centre_line, &varray, plane));
+  assert(primitive_overlaps_line(&runway, &centre_line, &varray, plane));
+
+  Primitive disjoint_line;
+  primitive_init(&disjoint_line);
+  add_side(&disjoint_line, add_vertex(&varray, 30000, 0));
+  add_side(&disjoint_line, add_vertex(&varray, 40000, 0));
+  assert(!primitive_overlaps_line(&runway, &disjoint_line, &varray, plane));
+
+  Primitive crossing_line;
+  primitive_init(&crossing_line);
+  add_side(&crossing_line, add_vertex(&varray, 0, -2000));
+  add_side(&crossing_line, add_vertex(&varray, 0, 2000));
+  assert(primitive_overlaps_line(&runway, &crossing_line, &varray, plane));
+
+  vertex_array_free(&varray);
+  return 0;
+}
